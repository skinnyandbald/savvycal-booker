# SavvyCal (get from https://savvycal.com/settings/integrations)
SAVVYCAL_TOKEN=pt_secret_your_token_here

# Cal.com (get from https://app.cal.com/settings/developer/api-keys)
CALCOM_API_KEY=cal_live_your_key_here

# Allow-lists (optional, comma-separated). Strongly recommended for public deployments:
# without them, anyone can use your API keys to book against any link, user, or event type.
# Unset or empty = allow any well-formed value.
# SAVVYCAL_ALLOWED_LINK_IDS=link_abc123,link_def456
# CALCOM_ALLOWED_USERNAMES=your-username
# CALCOM_ALLOWED_EVENT_SLUGS=pow-wow,chat-30
